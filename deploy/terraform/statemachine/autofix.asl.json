{
  "Comment": "Auto-fix agent: diagnose a failed run, propose a fix, approval 1 -> push a fix branch + deploy dev + check -> merge into staging + deploy staging + check -> approval 2 -> open a PR to main (and, if asked, deploy prod after it is merged)",
  "StartAt": "Propose",
  "States": {
    "Propose": {
      "Type": "Task",
      "Resource": "${propose}",
      "Retry": [{ "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException"], "MaxAttempts": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Error" }],
      "Next": "HasFix"
    },
    "HasFix": {
      "Type": "Choice",
      "Choices": [{ "Variable": "$.hasFix", "BooleanEquals": true, "Next": "ApproveFix" }],
      "Default": "NoFix"
    },
    "NoFix": { "Type": "Succeed" },

    "ApproveFix": {
      "Comment": "approval 1: push the proposed change",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${requestApproval}",
        "Payload": { "fixId.$": "$.fixId", "kind": "fix", "taskToken.$": "$$.Task.Token" }
      },
      "TimeoutSeconds": 86400,
      "ResultPath": "$.approval",
      "Catch": [
        { "ErrorEquals": ["States.Timeout"], "ResultPath": "$.error", "Next": "Expired" },
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Error" }
      ],
      "Next": "FixDecision"
    },
    "FixDecision": {
      "Type": "Choice",
      "Choices": [{ "Variable": "$.approval.decision", "StringEquals": "approve", "Next": "Push" }],
      "Default": "Rejected"
    },
    "Push": {
      "Type": "Task",
      "Resource": "${push}",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Error" }],
      "Next": "ToDev"
    },
    "ToDev": { "Type": "Pass", "Result": "dev", "ResultPath": "$.deployTo", "Next": "StartRun" },

    "StartRun": {
      "Type": "Task",
      "Resource": "${start}",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Error" }],
      "Next": "WaitRun"
    },
    "WaitRun": { "Type": "Wait", "Seconds": 60, "Next": "CheckRun" },
    "CheckRun": {
      "Type": "Task",
      "Resource": "${check}",
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 30, "MaxAttempts": 3 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Error" }],
      "Next": "RunDone"
    },
    "RunDone": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.done", "BooleanEquals": false, "Next": "WaitRun" },
        { "And": [
            { "Variable": "$.result", "StringEquals": "succeeded" },
            { "Variable": "$.deployTo", "StringEquals": "dev" }
          ], "Next": "MergeStaging" },
        { "And": [
            { "Variable": "$.result", "StringEquals": "succeeded" },
            { "Variable": "$.deployTo", "StringEquals": "staging" }
          ], "Next": "ApprovePromote" },
        { "Variable": "$.result", "StringEquals": "succeeded", "Next": "Green" }
      ],
      "Default": "MoreAttempts"
    },

    "MergeStaging": {
      "Comment": "dev is green: the agent merges the fix branch into staging itself (no review needed)",
      "Type": "Task",
      "Resource": "${mergeStaging}",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Error" }],
      "Next": "ToStaging"
    },
    "ToStaging": { "Type": "Pass", "Result": "staging", "ResultPath": "$.deployTo", "Next": "StartRun" },

    "ApprovePromote": {
      "Comment": "approval 2: staging is green. approve = open a PR to main and deploy prod after he merges it, pr_only = open the PR and stop, reject = leave the fix on staging",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${requestApproval}",
        "Payload": { "fixId.$": "$.fixId", "kind": "promote", "taskToken.$": "$$.Task.Token" }
      },
      "TimeoutSeconds": 86400,
      "ResultPath": "$.approval",
      "Catch": [
        { "ErrorEquals": ["States.Timeout"], "ResultPath": "$.error", "Next": "Expired" },
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Error" }
      ],
      "Next": "PromoteDecision"
    },
    "PromoteDecision": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.approval.decision", "StringEquals": "approve", "Next": "OpenPrForProd" },
        { "Variable": "$.approval.decision", "StringEquals": "pr_only", "Next": "OpenPrOnly" }
      ],
      "Default": "ProdRejected"
    },

    "OpenPrOnly": {
      "Type": "Task",
      "Resource": "${openPr}",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Error" }],
      "Next": "PrOpened"
    },

    "OpenPrForProd": {
      "Type": "Task",
      "Resource": "${openPr}",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Error" }],
      "Next": "WaitPr"
    },
    "WaitPr": { "Type": "Wait", "Seconds": 60, "Next": "CheckPr" },
    "CheckPr": {
      "Comment": "wait for him to merge the PR into main (only he merges into main)",
      "Type": "Task",
      "Resource": "${checkPr}",
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 30, "MaxAttempts": 3 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Error" }],
      "Next": "PrState"
    },
    "PrState": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.prState", "StringEquals": "merged", "Next": "ToProd" },
        { "Variable": "$.prState", "StringEquals": "closed", "Next": "PrClosed" },
        { "Variable": "$.prState", "StringEquals": "expired", "Next": "Expired" }
      ],
      "Default": "WaitPr"
    },
    "ToProd": { "Type": "Pass", "Result": "prod", "ResultPath": "$.deployTo", "Next": "StartRun" },

    "MoreAttempts": {
      "Type": "Choice",
      "Choices": [{ "Variable": "$.attempt", "NumericLessThan": ${maxAttempts}, "Next": "NextAttempt" }],
      "Default": "GaveUp"
    },
    "NextAttempt": {
      "Comment": "a new fix always goes through dev and staging again before prod",
      "Type": "Pass",
      "Parameters": { "fixId.$": "$.fixId", "runId.$": "$.newRunId", "attempt.$": "States.MathAdd($.attempt, 1)" },
      "Next": "Propose"
    },

    "Green":        { "Type": "Pass", "Parameters": { "fixId.$": "$.fixId", "outcome": "green" },         "Next": "Finish" },
    "PrOpened":     { "Type": "Pass", "Parameters": { "fixId.$": "$.fixId", "outcome": "pr_opened" },     "Next": "Finish" },
    "PrClosed":     { "Type": "Pass", "Parameters": { "fixId.$": "$.fixId", "outcome": "pr_closed" },     "Next": "Finish" },
    "Rejected":     { "Type": "Pass", "Parameters": { "fixId.$": "$.fixId", "outcome": "rejected" },      "Next": "Finish" },
    "ProdRejected": { "Type": "Pass", "Parameters": { "fixId.$": "$.fixId", "outcome": "prod_rejected" }, "Next": "Finish" },
    "Expired":      { "Type": "Pass", "Parameters": { "fixId.$": "$.fixId", "outcome": "expired" },       "Next": "Finish" },
    "GaveUp":       { "Type": "Pass", "Parameters": { "fixId.$": "$.fixId", "outcome": "gave_up" },       "Next": "Finish" },
    "Error":        { "Type": "Pass", "Parameters": { "fixId.$": "$.fixId", "outcome": "error", "detail.$": "$.error.Cause" }, "Next": "Finish" },
    "Finish":       { "Type": "Task", "Resource": "${finish}", "End": true }
  }
}
